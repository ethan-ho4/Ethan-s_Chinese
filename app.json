{
  "expo": {
    "name": "Ethan's Chinese",
    "slug": "ethans-chinese",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "ethanschinese",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethanho.ethanschinese",
      "buildNumber": "2",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to identify objects and unlock Chinese vocabulary words in your Chindex collection."
      }
    },
    "android": {
      "package": "com.ethanho.ethanschinese",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to identify objects and unlock Chinese vocabulary words in your Chindex collection."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c292106-e2cd-45aa-b4e5-bbd7f9b6d010"
      }
    },
    "owner": "galaxy4"
  }
}
